<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Recorded/logged climb videos live under the app's external files Movies dir
         (see AppContainer.moviesDirFor). -->
    <external-files-path name="movies" path="Movies/" />
    <!-- Rendered copies made for sharing/export (see DetailScreen's "Save to device" /
         story-sharing exports) are written to the cache dir first. -->
    <cache-path name="cache" path="." />
</paths>
