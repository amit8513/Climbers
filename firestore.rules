rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;

      match /friends/{friendUid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() &&
          (request.auth.uid == uid || request.auth.uid == friendUid) &&
          exists(/databases/$(database)/documents/friendRequests/$(request.auth.uid == uid
            ? friendUid + '_' + uid
            : uid + '_' + friendUid)) &&
          get(/databases/$(database)/documents/friendRequests/$(request.auth.uid == uid
            ? friendUid + '_' + uid
            : uid + '_' + friendUid)).data.status == 'ACCEPTED';
        allow update, delete: if false;
      }
    }

    match /usernames/{usernameLower} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /friendRequests/{requestId} {
      // resource is null when the doc doesn't exist yet (e.g. the existence check inside
      // sendFriendRequest's transaction, before the very first request between two users) —
      // that must stay readable or the existence check itself gets denied.
      allow read: if signedIn() &&
        (resource == null || request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
      allow create: if signedIn() && request.auth.uid == request.resource.data.fromUid;
      allow update: if signedIn() &&
        (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
      allow delete: if false;
    }

    function isFriendOf(ownerUid) {
      return exists(/databases/$(database)/documents/users/$(ownerUid)/friends/$(request.auth.uid));
    }

    // A synced copy of a shared climb — only ever created for climbs the owner marked
    // Friends-only or Public (see ClimbSyncRepository, which deletes this doc outright when a
    // climb goes back to Private, rather than leaving it around for a rule to hide).
    match /sharedClimbs/{climbId} {
      allow read: if signedIn() &&
        (resource.data.visibility == 'PUBLIC' ||
         (resource.data.visibility == 'FRIENDS_ONLY' && isFriendOf(resource.data.ownerUid)));
      allow create: if signedIn() &&
        request.auth.uid == request.resource.data.ownerUid &&
        request.resource.data.visibility in ['FRIENDS_ONLY', 'PUBLIC'];
      allow update: if signedIn() &&
        request.auth.uid == resource.data.ownerUid &&
        request.auth.uid == request.resource.data.ownerUid &&
        request.resource.data.visibility in ['FRIENDS_ONLY', 'PUBLIC'];
      allow delete: if signedIn() && request.auth.uid == resource.data.ownerUid;
    }

    // organizationId is stored as a Firestore number (from Kotlin Long), but a membership doc id
    // is "{organizationId}_{uid}" — a string. Rules' `+` operator errors on number+string (which
    // Firestore treats as the check failing, i.e. PERMISSION_DENIED) unless the number is first
    // converted with string(), matching Kotlin's membershipDocId().
    function isStaffOf(organizationId) {
      return exists(/databases/$(database)/documents/organizationMemberships/$(string(organizationId) + '_' + request.auth.uid)) &&
        get(/databases/$(database)/documents/organizationMemberships/$(string(organizationId) + '_' + request.auth.uid)).data.role in ['STAFF', 'ADMIN'];
    }

    // Any real membership qualifies (member, staff, or admin) — unlike isStaffOf, used for actions
    // any club member should be able to do, like posting in the group chat.
    function isMemberOf(organizationId) {
      return exists(/databases/$(database)/documents/organizationMemberships/$(string(organizationId) + '_' + request.auth.uid));
    }

    // Shared, monotonically-increasing id counters (one per entity type) so organization/venue/
    // zone/route ids stay plain Longs — see ClubRepository.nextId.
    match /counters/{counterName} {
      allow read, write: if signedIn();
    }

    // There's no in-app "create a club" button — the app only ever calls this once, to bootstrap
    // the single seed club it supports (see ClubRepository.ensureSeedOrganization). Left open to
    // any signed-in user at the rules layer rather than locked to an allowlist, matching this
    // app's existing trust level elsewhere (e.g. friendRequests).
    match /organizations/{orgId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // A membership is either you becoming ADMIN of a club you just created, or staff/admin of
    // that org approving someone else's join request — never a user granting themselves access.
    match /organizationMemberships/{membershipId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        (
          (request.resource.data.role == 'ADMIN' && request.resource.data.userId == request.auth.uid) ||
          isStaffOf(request.resource.data.organizationId)
        );
      allow update, delete: if false;
    }

    match /organizationJoinRequests/{requestId} {
      allow read: if signedIn() &&
        (resource == null || request.auth.uid == resource.data.userId || isStaffOf(resource.data.organizationId));
      allow create: if signedIn() && request.auth.uid == request.resource.data.userId && request.resource.data.status == 'PENDING';
      // Two different callers hit this as an "update" (the doc already exists): staff deciding a
      // pending request, or the same requester re-requesting after an earlier denial — a fresh
      // request reuses (and resets) the same doc id rather than piling up history.
      allow update: if signedIn() &&
        (
          isStaffOf(resource.data.organizationId) ||
          (
            request.auth.uid == resource.data.userId &&
            resource.data.status != 'PENDING' &&
            request.resource.data.status == 'PENDING' &&
            request.resource.data.userId == resource.data.userId &&
            request.resource.data.organizationId == resource.data.organizationId
          )
        );
      allow delete: if false;
    }

    match /venues/{venueId} {
      allow read: if signedIn();
      allow create: if signedIn() && isStaffOf(request.resource.data.organizationId);
      allow update: if signedIn() && isStaffOf(resource.data.organizationId);
      allow delete: if signedIn() && isStaffOf(resource.data.organizationId);
    }

    match /zones/{zoneId} {
      allow read: if signedIn();
      allow create: if signedIn() && isStaffOf(request.resource.data.organizationId);
      allow update: if signedIn() && isStaffOf(resource.data.organizationId);
      allow delete: if signedIn() && isStaffOf(resource.data.organizationId);
    }

    // Deleting a venue/zone cascades to every route beneath it (see ClubRepository.deleteZoneCascade),
    // so routes/routeVersions need the same staff-delete grant, not just venues/zones themselves.
    match /routes/{routeId} {
      allow read: if signedIn();
      allow create: if signedIn() && isStaffOf(request.resource.data.organizationId);
      allow update: if signedIn() && isStaffOf(resource.data.organizationId);
      allow delete: if signedIn() && isStaffOf(resource.data.organizationId);
    }

    match /routeVersions/{versionId} {
      allow read: if signedIn();
      allow create: if signedIn() && isStaffOf(request.resource.data.organizationId);
      allow update: if false;
      allow delete: if signedIn() && isStaffOf(resource.data.organizationId);
    }

    match /cameras/{cameraId} {
      allow read: if signedIn();
      allow create: if signedIn() && isStaffOf(request.resource.data.organizationId);
      allow update: if signedIn() && isStaffOf(resource.data.organizationId);
      allow delete: if signedIn() && isStaffOf(resource.data.organizationId);
    }

    match /clubUpdates/{updateId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        isStaffOf(request.resource.data.organizationId) &&
        request.resource.data.authorUid == request.auth.uid;
      allow update: if false;
      // Any staff member can delete any post (moderation), not just the original author — same
      // trust level as creating one, just without the author-must-match-self restriction create has.
      allow delete: if signedIn() && isStaffOf(resource.data.organizationId);
    }

    // The club's single group chat thread — unlike clubUpdates, any real member (not just staff)
    // can post, and messages are never edited or deleted (a plain append-only log).
    match /clubMessages/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        isMemberOf(request.resource.data.organizationId) &&
        request.resource.data.senderUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Attempt-count bookkeeping for the member-facing club leaderboard — any member can record
    // their own stats (it's their own participation data, not a staff action), but never anyone
    // else's.
    match /clubStats/{statsId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // Who has sent a specific route — same trust level as clubStats (you can only ever write
    // your own completion record, never someone else's).
    match /routeCompletions/{completionId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // Route-wide attempt/send/fail counters — unlike clubStats there's no single owning user (it
    // aggregates every member's attempts), so this is open to any signed-in member, same trust
    // level as /counters.
    match /routeStats/{routeId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if false;
    }

    // A member's own sent-attempt video, shared publicly for other members to watch on that
    // route's page — any member can share (participation, not a staff mutation), never edited or
    // deleted (a plain append-only log, same as clubMessages).
    match /sharedAttempts/{sharedAttemptId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        isMemberOf(request.resource.data.organizationId) &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Who has liked a shared attempt video — doc id "{sharedAttemptId}_{uid}" means a user can
    // only ever create/delete their OWN like, never anyone else's (same shape as routeCompletions).
    match /sharedAttemptLikes/{likeId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow update: if false;
    }
  }
}
