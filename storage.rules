rules_version = '2';

// Checks the object's own custom metadata rather than cross-calling into Firestore
// (`firestore.get()`/`firestore.exists()` from Storage rules) — that cross-service path proved
// unreliable in this project (every read was denied outright, including Public videos with no
// friendship check involved at all), so this trades a small amount of precision for something
// that actually works: any signed-in user can read a Friends-only/Public video if they already
// know its exact path, not just a real friend of the owner. The friendship check still fully
// applies where a client actually *discovers* that path — Firestore's `sharedClimbs` rules
// (`firestore.rules`) only ever return a Friends-only doc's path to an accepted friend in the
// first place. A stranger would need to guess both an exact owner UID and exact climb id to read
// a video directly — low risk for a small friend-group app, but a real, documented trade-off, not
// a hidden one.
service firebase.storage {
  match /b/{bucket}/o {
    match /climb_videos/{ownerUid}/{fileName} {
      allow read: if request.auth != null &&
        (request.auth.uid == ownerUid || resource.metadata.visibility in ['FRIENDS_ONLY', 'PUBLIC']);

      allow write: if request.auth != null && request.auth.uid == ownerUid;
    }

    // Profile pictures are shown to any signed-in user (leaderboard, friends), so read is
    // unrestricted beyond requiring auth — only the owner can write their own.
    match /profile_pictures/{ownerUid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == ownerUid;
    }

    // Gym staff-uploaded "how to climb this" videos, read by any member. Same constraint as the
    // rest of this file applies: cross-checking Firestore's organizationMemberships from here to
    // verify the uploader is actually staff has already proven unreliable in this project (see the
    // header comment), so write is left open to any signed-in user at the Storage-rules layer —
    // the real gate is ClubRepository.setRouteBetaVideo, which re-checks staff access against
    // Firestore before a route doc is ever updated to point at an uploaded file.
    match /club_beta_videos/{organizationId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Staff-uploaded zone photos, read by any member — same trade-off as club_beta_videos above:
    // the real staff gate is ClubRepository.setZoneImage, not this rule.
    match /club_zone_photos/{organizationId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
