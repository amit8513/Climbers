rules_version = '2';

// Mirrors firestore.rules' `sharedClimbs` visibility check for the video files themselves —
// the Firestore doc (checked via `firestore.get()`) is the single source of truth for who's
// allowed to read a climb's video; nothing here duplicates that decision independently.
service firebase.storage {
  match /b/{bucket}/o {
    match /climb_videos/{ownerUid}/{fileName} {
      function climbId() {
        return fileName.split('.')[0];
      }

      function sharedClimb() {
        return firestore.get(/databases/(default)/documents/sharedClimbs/$(ownerUid + '_' + climbId())).data;
      }

      function isFriendOf(uid) {
        return firestore.exists(/databases/(default)/documents/users/$(uid)/friends/$(request.auth.uid));
      }

      allow read: if request.auth != null &&
        (request.auth.uid == ownerUid ||
         sharedClimb().visibility == 'PUBLIC' ||
         (sharedClimb().visibility == 'FRIENDS_ONLY' && isFriendOf(ownerUid)));

      allow write: if request.auth != null && request.auth.uid == ownerUid;
    }
  }
}
